# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs API Key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# D-ID API Key (for avatar generation)
DID_API_KEY=your-did-api-key

# Google OAuth Client ID
# Get this from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret (use a random string, change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# MongoDB Configuration
# For Docker: This will be auto-configured by docker-compose
# For local development, use: mongodb://admin:admin123@localhost:27017/eduvideo?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
MONGODB_URI=mongodb://admin:admin123@localhost:27017/eduvideo?authSource=admin

# Razorpay Configuration
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
